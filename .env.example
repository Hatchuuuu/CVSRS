# Names and descriptions only. Never commit real values. Provide them through the deployment's secret manager.

# --- Production / staging (Supabase) ---
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key. Safe for browsers ONLY because authorization is enforced by RLS and command functions.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical HTTPS origin of this deployment. Configure the same origin in Supabase Auth URL settings.
CVSRS_PUBLIC_URL=
# Disable "Confirm email" in Supabase Auth: new accounts must be automatically confirmed and signed in immediately.
# Signup must not send verification or confirmation emails. Password recovery still uses email.
# Allow this exact password-recovery redirect URL in Supabase Auth:
#   https://<your-host>/auth/callback?next=/account/reset-password
# Password-recovery emails return through that PKCE callback in the browser that requested the reset.
# Certificate renderer signing secret. Generate at least 32 random bytes (for example, 64 hex characters).
# Set the same value in the server runtime and private.certificate_render_secrets in the database.
# Never use a NEXT_PUBLIC_ prefix or expose it to browsers.
# CVSRS_CERTIFICATE_RENDER_SECRET=
# The service-role/secret key must NEVER be set in the web app's environment or exposed to the browser.
# Worker database credentials belong only in the isolated worker runtime; no service-role key is needed by the web app.

# --- Local development ---
# Nothing to set: `npm run dev` starts the local Supabase stack and passes its URL, publishable key, a local certificate secret
# and a least-privilege worker login to the app (secrets in the ignored .local/dev-secrets.json). Put the variables above in
# .env.local only to develop against a hosted project with `npm run dev:next`.
# The database tests use their own disposable cluster (scripts/db.ts) and need no variables (PG_BIN optional).

# --- SMS (optional) ---
# none (default) | sandbox (automated tests only: sends nothing; rejected in production).
# Real providers are added and validated in src/lib/sms once an account exists.
# SMS_PROVIDER=none
# Shared secret used to verify delivery-receipt callbacks (HMAC-SHA256 of the raw body, hex, header x-signature).
# SMS_WEBHOOK_SECRET=
# Separate worker-only database login granted the cvsrs_outbox_worker group; never supplied to the web runtime.
# CVSRS_WORKER_DB_URL=
# Webhook-only login with membership in cvsrs_sms_webhook, not worker/admin credentials. Web runtime only, and only when
# real SMS delivery receipts are enabled.
# CVSRS_SMS_WEBHOOK_DB_URL=
# Shared production rate limits (Redis REST endpoint supporting EVAL).
# Server-only credentials. No local bucket fallback in production.
CVSRS_RATE_LIMIT_URL=
CVSRS_RATE_LIMIT_TOKEN=
# Client-address header for request limits (one header name, e.g. the platform's real-IP header). Required in production
# unless CVSRS_RATE_LIMIT_ALLOW_SHARED_BUCKET=1. Use it only when ingress overwrites the header on every request and direct
# origin access is blocked; never blindly trust x-forwarded-for.
CVSRS_TRUSTED_CLIENT_IP_HEADER=
# Explicit production opt-in (blank or 1) to run without a client address: public routes then share one allowance per route
# (20x the route limit), so one client can slow certificate checks for everyone. Signed-in users are still limited per user.
# CVSRS_RATE_LIMIT_ALLOW_SHARED_BUCKET=

# --- Sessions ---
# Max-Age of the Supabase session cookies in seconds (300-2592000). Blank = 43200 (12 hours).
# CVSRS_SESSION_COOKIE_MAX_AGE_SECONDS=
# Minutes without input before signed-in staff are signed out (60-second warning first). 0 = off, otherwise 2-720. Blank = 15.
# Build-time (NEXT_PUBLIC_): rebuild after changing it.
# NEXT_PUBLIC_CVSRS_STAFF_IDLE_MINUTES=
