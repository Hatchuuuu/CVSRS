{
  "name": "cvsrs",
  "version": "0.1.0",
  "private": true,
  "description": "CVSRS - Children's Vaccination Scheduling and Records System",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "tsx scripts/prepare-ocr.ts",
    "ocr:prepare": "tsx scripts/prepare-ocr.ts",
    "dev": "tsx scripts/dev.ts",
    "dev:next": "next dev --hostname localhost",
    "dev:stop": "supabase stop",
    "setup:first-staff": "tsx scripts/setup-first-staff.ts",
    "build": "next build",
    "start": "next start --hostname localhost",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "db:start": "tsx scripts/db.ts start",
    "db:stop": "tsx scripts/db.ts stop",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "worker": "tsx scripts/worker.ts",
    "drill:restore": "tsx scripts/backup-drill.ts",
    "drill:upgrade": "tsx scripts/upgrade-drill.ts",
    "perf": "tsx scripts/perf.ts",
    "matrix": "tsx scripts/matrix.ts",
    "matrix:check": "tsx scripts/matrix.ts --check",
    "db:install-sql": "tsx scripts/build-supabase-install.ts",
    "test:all": "npm run typecheck && npm run lint && npm run test:unit && npm run test:db && npm run matrix:check"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "fontkit": "^2.0.4",
    "lucide-react": "^1.48.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "page-mascot": "^0.1.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "supabase": "^2.119.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "type": "module"
}
